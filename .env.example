# saesun-care-schedule과 완전히 동일한 이름 + 동일한 값을 그대로 씁니다.
# (Vercel 대시보드에서 saesun-care-schedule 프로젝트의 값을 복사해서
#  이 프로젝트(care-schedule)에 똑같은 이름으로 붙여넣으면 됩니다.)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# saesun-care-schedule에 이미 있는 ADMIN_PASSWORD와 같은 값을 써도 되고, 이 앱만의
# 별도 비밀번호를 정해도 됩니다.
ADMIN_PASSWORD=관리자_비밀번호

# 이 앱에서만 새로 필요한 값 (saesun에는 없음) — 로그인 세션 서명용, 아무 긴 임의 문자열
SESSION_SECRET=임의의_긴_랜덤_문자열_세션_서명용
